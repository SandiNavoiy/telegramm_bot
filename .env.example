# Токен бота из Telegram @BotFather
TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyZ

# (Опционально) API ключ для APILayer exchangerates_data
# Если не указан, бот автоматически использует бесплатный API ЦБ РФ (cbr-xml-daily.ru)
API_KEY=

# (Опционально) ID вашего Telegram аккаунта для принудительного получения сообщений
ADMIN_CHAT_ID=

# Часовой пояс работы бота (по умолчанию Europe/Moscow)
TIMEZONE=Europe/Moscow

# Процент отклонения для срабатывания алерта (по умолчанию 10.0)
DEVIATION_THRESHOLD_PERCENT=10.0
